{
  "name": "touba-shoes-storefront",
  "version": "0.4.0",
  "private": true,
  "description": "Persian RTL shoe storefront with Supabase auth and server-side BluePal (بلو پال) checkout",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node local-server.js",
    "start": "node local-server.js",
    "bluepal:status": "node scripts/bluepal-cli.js config",
    "bluepal:check": "node scripts/bluepal-cli.js verify",
    "bluepal:expire": "node scripts/bluepal-cli.js expire",
    "vercel:env": "node scripts/vercel-env.js",
    "vercel:env:list": "node scripts/vercel-env.js --list",
    "start:comfy": "uvicorn comfy-automation-api.app.main:app --host 0.0.0.0 --port 8000",
    "build": "node scripts/check.js && node scripts/build-vercel.js",
    "lint": "node scripts/check.js",
    "test": "node tests/supabase-commerce.js && node tests/ai-studio.js && node tests/vercel-api.js && node tests/supabase-auth.js && node tests/bluepal.js && node tests/runtime-smoke.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "2.117.2"
  }
}
