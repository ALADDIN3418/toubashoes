{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/ai/describe.js": {
      "maxDuration": 60
    },
    "api/ai/product-photo.js": {
      "maxDuration": 120
    },
    "api/ai/studio/generate.js": {
      "maxDuration": 120
    },
    "api/seo.js": {
      "maxDuration": 30,
      "includeFiles": "index.html"
    },
    "api/payment/bitpay/request.js": {
      "maxDuration": 30
    },
    "api/payment/bitpay/verify.js": {
      "maxDuration": 30
    },
    "api/payment/bitpay/status.js": {
      "maxDuration": 30
    },
    "api/payment/bitpay/callback.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/seo?type=sitemap"
    },
    {
      "source": "/shop",
      "destination": "/api/seo?type=shop"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/seo?type=product&slug=:slug"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/seo?type=category&slug=:slug"
    },
    {
      "source": "/cart",
      "destination": "/api/seo?type=private&path=cart"
    },
    {
      "source": "/checkout",
      "destination": "/api/seo?type=private&path=checkout"
    },
    {
      "source": "/login",
      "destination": "/api/seo?type=private&path=login"
    },
    {
      "source": "/account",
      "destination": "/api/seo?type=private&path=account"
    },
    {
      "source": "/account/:path*",
      "destination": "/api/seo?type=private&path=account/:path*"
    },
    {
      "source": "/wishlist",
      "destination": "/api/seo?type=private&path=wishlist"
    },
    {
      "source": "/tracking",
      "destination": "/api/seo?type=private&path=tracking"
    },
    {
      "source": "/search",
      "destination": "/api/seo?type=private&path=search"
    },
    {
      "source": "/payment/result/:id",
      "destination": "/api/seo?type=private&path=payment/result/:id"
    },
    {
      "source": "/admin",
      "destination": "/api/seo?type=private&path=admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/seo?type=private&path=admin/:path*"
    },
    {
      "source": "/22342065.txt",
      "destination": "/22342065.txt"
    },
    {
      "source": "/22274320.txt",
      "destination": "/22274320.txt"
    },
    {
      "source": "/22084634.txt",
      "destination": "/22084634.txt"
    },
    {
      "source": "/20838126.txt",
      "destination": "/20838126.txt"
    },
    {
      "source": "/18887070.txt",
      "destination": "/18887070.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
