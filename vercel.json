{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/payment/zarinpal/request.js": { "maxDuration": 30 },
    "api/payment/zarinpal/callback.js": { "maxDuration": 30 },
    "api/payment/zarinpal/receipt.js": { "maxDuration": 30 },
    "api/ai/product-photo.js": { "maxDuration": 120 },
    "api/ai/studio/generate.js": { "maxDuration": 120 },
    "api/ai/describe.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
