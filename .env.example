# ═══════════════════════════════════════════════════════════════════════════
# کپی کنید به .env برای اجرای local-server.js (این فایل در Git نیست).
# برای Vercel از الگوی جداگانه استفاده کنید: vercel.env.example
# و با node scripts/vercel-env.js --project <name> اعمالش کنید (راهنما: PRODUCTION_READINESS.md).
# ═══════════════════════════════════════════════════════════════════════════

# Supabase
GEMINI_API_KEY=
PORT=3000
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# (در مستندات تازهٔ Supabase همین مقدار را secret key می‌گوید؛ SUPABASE_SECRET_KEY هم پذیرفته می‌شود)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=


# بیت‌پی (BitPay · bitpay.ir — تنها درگاه پرداخت، مستقیم به صفحهٔ بانک)
# مقادیر را هرگز در Git-commit یا لاگ چاپ نکنید.
# راز | کلید ۵۲ کاراکتری «بخش توسعه ← فعال‌سازی API» پنل بیت‌پی (مرچنت‌کد درگاه).
#   دامنهٔ دقیق سایت (https) باید در پنل بیت‌پی ثبت شده باشد؛ مقدار خالی = پرداخت خاموش.
BITPAY_API_KEY=
# اختیاری | نشانی قطعی فروشگاه برای بازگشت از درگاه (پیش‌فرض: https://toubashose.ir)
# BITPAY_SITE_ORIGIN=https://toubashose.ir
