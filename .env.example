# ═══════════════════════════════════════════════════════════════════════════
# کپی کنید به .env برای اجرای local-server.js (این فایل در Git نیست).
# برای Vercel از الگوی جداگانه استفاده کنید: vercel.env.example
# و با node scripts/vercel-env.js --project <name> اعمالش کنید (راهنما: BLUEPAL_OPERATIONS.md).
# ═══════════════════════════════════════════════════════════════════════════

# Supabase
GEMINI_API_KEY=
PORT=3000
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# بلو پال (BluePal · درگاه پرداخت بانکی) — مقادیر را هرگز در Git-commit یا لاگ چاپ نکنید.
# BLUEPAL_MODE: sandbox (کلید آزمایشی sk_test_) | production (وجه واقعی با sk_live_)
# برای غیرفعال‌کردن کامل پرداخت، BLUEPAL_API_KEY را تنظیم نکنید.
# دریافت وجه واقعی تا تنظیم BLUEPAL_ENABLE_LIVE_PAYMENTS=true قفل است.
BLUEPAL_MODE=sandbox
BLUEPAL_API_KEY=
BLUEPAL_MERCHANT_ID=
BLUEPAL_STATE_SECRET=
BLUEPAL_API_BASE=https://www.bluepal.ir/api
BLUEPAL_WEBHOOK_SECRET=
BLUEPAL_WEBHOOK_SIGNATURE_HEADER=x-bluepal-signature
BLUEPAL_REQUIRE_WEBHOOK_SIGNATURE=false
BLUEPAL_REQUIRE_MERCHANT_ID=
BLUEPAL_PUBLIC_ORIGIN=
BLUEPAL_ALLOWED_PAY_HOSTS=
BLUEPAL_SETTLE_GRACE_MINUTES=180
BLUEPAL_ENABLE_LIVE_PAYMENTS=false
