# Public Supabase Auth configuration used by the browser client.
# These values are also public in the page runtime; never put service-role keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional compatibility alias for older Supabase projects:
SUPABASE_ANON_KEY=

# Cloudflare Workers AI · FLUX.2 [klein] 4B (reference-image editing; Apache-2.0 model)
# Create a Cloudflare API token with Workers AI Read permission.
# Keep real values only in .env or Vercel Environment Variables; never commit or send in chat.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
