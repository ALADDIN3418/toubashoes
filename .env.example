# Optional commerce integrations remain disabled; this project still uses local mock data.
DATA_PROVIDER=mock

# Supabase connection is not wired into the storefront yet; keep unset until
# the production API/data-provider implementation is deployed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers AI · FLUX.2 [klein] 4B (reference-image editing; Apache-2.0 model)
# Create a Cloudflare API token with Workers AI Read permission.
# Keep real values only in .env on the server; never commit or send them in chat.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
