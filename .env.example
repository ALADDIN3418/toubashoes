# ═══════════════════════════════════════════════════════════════════════════
# کپی کنید به .env برای اجرای local-server.js (این فایل در Git نیست).
# برای Vercel از الگوی جداگانه استفاده کنید: vercel.env.example
# و با node scripts/vercel-env.js --project <name> اعمالش کنید (راهنما: BLUPAL_OPERATIONS.md).
# ═══════════════════════════════════════════════════════════════════════════

# Supabase
GEMINI_API_KEY=
PORT=3000
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# (در مستندات تازهٔ Supabase همین مقدار را secret key می‌گوید؛ SUPABASE_SECRET_KEY هم پذیرفته می‌شود)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# بلوپال (BluPal · blupal.top — درگاه کارت‌به‌کارت با فاکتور)
# مقادیر را هرگز در Git-commit یا لاگ چاپ نکنید.
# BLUPAL_MODE: sandbox (کلید آزمایشی blu_test_) | production (وجه واقعی با blu_live_)
# برای غیرفعال‌کردن کامل پرداخت، BLUPAL_API_KEY را تنظیم نکنید.
# دریافت وجه واقعی تا تنظیم BLUPAL_ENABLE_LIVE_PAYMENTS=true قفل است.
# ─── بیت‌پی (BitPay · bitpay.ir) — درگاه موازی، اختیاری (v1.2.0) ─────────────────
# راز | کلید ۵۲ کاراکتری «بخش توسعه ← فعال‌سازی API» پنل بیت‌پی. خالی = بیت‌پی خاموش،
#   بلوپال بدون هیچ تغییری کار می‌کند. آدرس سایت در پنل باید همین دامنهٔ https باشد.
BITPAY_API_KEY=

BLUPAL_MODE=sandbox
BLUPAL_API_KEY=
BLUPAL_STATE_SECRET=
BLUPAL_API_BASE=https://blupal.top/api
BLUPAL_CARD_NUMBER=
BLUPAL_ALLOWED_PAY_HOSTS=
BLUPAL_SETTLE_GRACE_MINUTES=60
BLUPAL_ENABLE_LIVE_PAYMENTS=false
