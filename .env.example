# ═══════════════════════════════════════════════════════════════════════════
# کپی کنید به .env برای اجرای local-server.js (این فایل در Git نیست).
# برای Vercel از الگوی جداگانه استفاده کنید: vercel.env.example
# و با node scripts/vercel-env.js --project <name> اعمالش کنید (راهنما: BALEPAY_OPERATIONS.md).
# ═══════════════════════════════════════════════════════════════════════════

# Supabase
GEMINI_API_KEY=
PORT=3000
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# بله‌پی (پرداخت کیف‌پول بله) — مقادیر را هرگز در Git-commit یا لاگ چاپ نکنید.
# BALEPAY_MODE: sandbox (آزمایشی) | production (وجه واقعی) | disabled (غیرفعال)
# در sandbox توکن provider باید WALLET-TEST-1111111111111111 باشد و
# BALEPAY_STATE_SECRET باید دست‌کم ۳۲ کاراکتر تصادفی باشد.
BALEPAY_MODE=sandbox
BALEPAY_BOT_TOKEN=
BALEPAY_PROVIDER_TOKEN=
BALEPAY_BOT_USERNAME=
BALEPAY_STATE_SECRET=
# راز هدر وب‌هوک (x-balepay-secret) — اگر Webhook در پنل بله آن را پشتیبانی کند
BALEPAY_WEBHOOK_SECRET=
BALEPAY_REQUIRE_WEBHOOK_SECRET=
# برای دریافت وجه واقعی در production لازم است
BALEPAY_ENABLE_LIVE_PAYMENTS=
# اختیاری: نشانی عمومی HTTPS (ساخت آدرس وب‌هوک در CLI) و پیش‌فرض API
BALEPAY_PUBLIC_ORIGIN=
BALEPAY_API_BASE=
