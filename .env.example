# Public Supabase browser configuration (never add service-role keys here)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key name when the project does not expose publishable keys
SUPABASE_ANON_KEY=

# Product-description writing assistant only; never used by the image studio
GEMINI_API_KEY=

# ZarinPal — sandbox by default; merchant and state secret are server-only
ZARINPAL_MODE=sandbox
ZARINPAL_MERCHANT_ID=
ZARINPAL_STATE_SECRET=
