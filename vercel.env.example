# ═══════════════════════════════════════════════════════════════════════════
# متغیرهای محیطی کامل پروژهٔ «کفش طوبی» روی Vercel
#
# ۱) کپی کنید به فایلی خارج از Git:  cp vercel.env.example vercel.env.local
# ۲) مقدارهای خالی را پر کنید (هر کلیدی که مقدارش خالی بماند ارسال نمی‌شود).
# ۳) اعمال روی ورسِل:
#      VERCEL_TOKEN=<توکن> node scripts/vercel-env.js --project <نام یا prj_شناسه> --dry-run
#      VERCEL_TOKEN=<توکن> node scripts/vercel-env.js --project <نام یا prj_شناسه>
#      node scripts/vercel-env.js --list --project <نام>      # بررسی نهایی (بدون نمایش مقدار)
#
# نوع ذخیره‌سازی خودکار انتخاب می‌شود: کلیدهای راز → sensitive (فقط‌نوشتنی)،
# بقیه → encrypted. با --secret-type=encrypted می‌توان همه را خواندنی کرد.
# راهنمای کامل: BLUPAL_OPERATIONS.md
# ═══════════════════════════════════════════════════════════════════════════

# ─── بلوپال (BluPal · blupal.top) ────────────────────────────────────────────
# الزامی | محیط پرداخت: sandbox (کلید blu_test_) یا production (کلید blu_live_ و وجه واقعی)
BLUPAL_MODE=sandbox
# الزامی | راز | کلید «API درگاه» از پنل بلوپال؛ قالب blu_test_… یا blu_live_…
#   این تنها روش احراز است (هدر X-API-Key، فقط سمت سرور). کلید را در پنل بچرخانید اگر جایی لو رفته.
BLUPAL_API_KEY=
# الزامی | راز | رشتهٔ تصادفی ≥۳۲ بایت برای امضای رسید وضعیت پرداخت
#   تولید: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BLUPAL_STATE_SECRET=
# اختیاری | پیش‌فرض https://blupal.top/api (پایگاه مستندات پنل)
BLUPAL_API_BASE=https://blupal.top/api
# اختیاری | شمارهٔ کارت ۱۶ رقمی مقصد؛ خالی بماند بلوپال کارت فعال پیش‌فرض پنل را انتخاب می‌کند
#   (در حالت sandbox این مقدار از سوی درگاه نادیده گرفته می‌شود)
BLUPAL_CARD_NUMBER=
# اختیاری | میزبان‌های مجاز صفحهٔ پرداخت بلوپال، جداشده با کاما (پیش‌فرض: میزبان API)
BLUPAL_ALLOWED_PAY_HOSTS=
# اختیاری | دقیقه؛ مهلت پرداخت‌نشده‌ماندن فاکتور پیش از آزادشدن رزرو موجودی (حداقل ۱۵)
BLUPAL_SETTLE_GRACE_MINUTES=60
# قفل دریافت وجه واقعی: تا true نشود، در production فاکتور ساخته نمی‌شود
BLUPAL_ENABLE_LIVE_PAYMENTS=false

# ─── Supabase (دیتابیس، احراز هویت و سبد/سفارش) ─────────────────────────────
# الزامی | نشانی پروژه
SUPABASE_URL=
# الزامی | کلید public/publishable که مرورگر می‌خواند (عمومی است)
SUPABASE_PUBLISHABLE_KEY=
# اختیاری | نام دیگر کلید عمومی در پروژه‌های قدیمی
SUPABASE_ANON_KEY=
# الزامی | راز | service_role — فقط سمت سرور؛ هرگز در مرورگر یا Git
SUPABASE_SERVICE_ROLE_KEY=

# ─── سایر ───────────────────────────────────────────────────────────────────
# اختیاری | راز | کلید Gemini برای دستیار توضیحات محصول (فقط سمت سرور)
GEMINI_API_KEY=
# اختیاری | پورت سرور محلی؛ روی Vercel لازم نیست
PORT=3000
