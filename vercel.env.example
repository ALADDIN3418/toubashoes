# ═══════════════════════════════════════════════════════════════════════════
# متغیرهای محیطی کامل پروژهٔ «کفش طوبی» روی Vercel
#
# ۱) کپی کنید به فایلی خارج از Git:  cp vercel.env.example vercel.env.local
# ۲) مقدارهای خالی را پر کنید (هر کلیدی که مقدارش خالی بماند ارسال نمی‌شود).
# ۳) اعمال روی ورسِل:
#      VERCEL_TOKEN=<توکن> node scripts/vercel-env.js --project <نام یا prj_شناسه> --dry-run
#      VERCEL_TOKEN=<توکن> node scripts/vercel-env.js --project <نام یا prj_شناسه>
#      node scripts/vercel-env.js --list --project <نام>      # بررسی نهایی (بدون نمایش مقدار)
#
# نوع ذخیره‌سازی خودکار انتخاب می‌شود: کلیدهای راز → sensitive (فقط‌نوشتنی)،
# بقیه → encrypted. با --secret-type=encrypted می‌توان همه را خواندنی کرد.
# راهنمای کامل: BLUEPAL_OPERATIONS.md
# ═══════════════════════════════════════════════════════════════════════════

# ─── بلو پال (BluePal · درگاه پرداخت بانکی) ─────────────────────────────────
# الزامی | محیط پرداخت: sandbox (کلید sk_test_) یا production (کلید sk_live_ و وجه واقعی)
BLUEPAL_MODE=sandbox
# الزامی | راز | کلید API پنل بلو پال؛ فرمت sk_test_… یا sk_live_… (محیط با آن تطبیق داده می‌شود)
BLUEPAL_API_KEY=
# الزامی | merchant_id پذیرنده از پنل بلو پال؛ در production نبودش خطای پیکربندی می‌دهد
BLUEPAL_MERCHANT_ID=
# الزامی | راز | رشتهٔ تصادفی ≥۳۲ بایت برای امضای رسید و آدرس بازگشت
#   تولید: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BLUEPAL_STATE_SECRET=
# اختیاری | پیش‌فرض https://www.bluepal.ir/api (مستندات /developers)
BLUEPAL_API_BASE=https://www.bluepal.ir/api
# اختیاری | راز | راز ≥۱۶ کاراکتری که در پنل، هدر امضای اعلان نتیجه تنظیم می‌شود
BLUEPAL_WEBHOOK_SECRET=
# اختیاری | نام هدر امضای اعلان (پیش‌فرض x-bluepal-signature)
BLUEPAL_WEBHOOK_SIGNATURE_HEADER=x-bluepal-signature
# اختیاری | true ⇒ اعلان بدون هدر امضای درست پاسخ ۴۰۱ می‌گیرد
BLUEPAL_REQUIRE_WEBHOOK_SIGNATURE=false
# اختیاری | true ⇒ حتی در sandbox هم نبودِ شناسهٔ پذیرنده مجاز نیست
BLUEPAL_REQUIRE_MERCHANT_ID=
# اختیاری | نشانی عمومی HTTPS فروشگاه؛ برای ساخت callback وقتی مبدأ درخواست قابل‌اطمینان نیست
BLUEPAL_PUBLIC_ORIGIN=
# اختیاری | میزبان‌های مجاز صفحهٔ پرداخت بلو پال، جداشده با کاما (پیش‌فرض: میزبان API)
BLUEPAL_ALLOWED_PAY_HOSTS=
# اختیاری | دقیقه؛ مهلت تأیید نشدن پرداخت پیش از آزادشدن رزرو سفارش
BLUEPAL_SETTLE_GRACE_MINUTES=180
# قفل دریافت وجه واقعی: تا true نشود، در production درخواست پرداخت ساخته نمی‌شود
BLUEPAL_ENABLE_LIVE_PAYMENTS=false

# ─── Supabase (دیتابیس، احراز هویت و سبد/سفارش) ─────────────────────────────
# الزامی | نشانی پروژه
SUPABASE_URL=
# الزامی | کلید public/publishable که مرورگر می‌خواند (عمومی است)
SUPABASE_PUBLISHABLE_KEY=
# اختیاری | نام دیگر کلید عمومی در پروژه‌های قدیمی
SUPABASE_ANON_KEY=
# الزامی | راز | service_role — فقط سمت سرور؛ هرگز در مرورگر یا Git
SUPABASE_SERVICE_ROLE_KEY=

# ─── سایر ───────────────────────────────────────────────────────────────────
# اختیاری | راز | کلید Gemini برای دستیار توضیحات محصول (فقط سمت سرور)
GEMINI_API_KEY=
# اختیاری | پورت سرور محلی؛ روی Vercel لازم نیست
PORT=3000
