# ═══════════════════════════════════════════════════════════════════════════
# متغیرهای محیطی کامل پروژهٔ «کفش طوبی» روی Vercel
#
# ۱) کپی کنید به فایلی خارج از Git:  cp vercel.env.example vercel.env.local
# ۲) مقدارهای خالی را پر کنید (هر کلیدی که مقدارش خالی بماند ارسال نمی‌شود).
# ۳) اعمال روی ورسِل:
#      VERCEL_TOKEN=<توکن> node scripts/vercel-env.js --project <نام یا prj_شناسه> --dry-run
#      VERCEL_TOKEN=<توکن> node scripts/vercel-env.js --project <نام یا prj_شناسه>
#      node scripts/vercel-env.js --list --project <نام>      # بررسی نهایی (بدون نمایش مقدار)
#
# نوع ذخیره‌سازی خودکار انتخاب می‌شود: کلیدهای راز → sensitive (فقط‌نوشتنی)،
# بقیه → encrypted. با --secret-type=encrypted می‌توان همه را خواندنی کرد.
# ═══════════════════════════════════════════════════════════════════════════

# ─── بله‌پی (Bale Pay · پرداخت کیف‌پول بله) ─────────────────────────────────
# الزامی | محیط پرداخت: sandbox (توکن آزمایشی) یا production (وجه واقعی)
BALEPAY_MODE=sandbox
# الزامی | راز | توکن بازو از @botfather — فرمت 123456789:abcdIuZmK5q…
BALEPAY_BOT_TOKEN=
# الزامی | راز | توکن پرداخت کیف‌پول همان بازو؛ برای آزمون:
#   WALLET-TEST-1111111111111111
BALEPAY_PROVIDER_TOKEN=
# الزامی | راز | رشتهٔ تصادفی ≥۳۲ کاراکتر برای امضای payload صورتحساب و رسید
#   تولید: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BALEPAY_STATE_SECRET=
# توصیه‌شده | نام کاربری بازو بدون @ — پیوند مینی‌اپ با آن ساخته می‌شود
BALEPAY_BOT_USERNAME=
# اختیاری | راز | راز ≥۱۶ کاراکتری هدر x-balepay-secret (برای Production توصیه می‌شود)
BALEPAY_WEBHOOK_SECRET=
# اختیاری | true ⇒ وب‌هوک بدون هدر درست پاسخ ۴۰۱ می‌گیرد
BALEPAY_REQUIRE_WEBHOOK_SECRET=false
# اختیاری | نشانی عمومی HTTPS فروشگاه؛ فقط برای ساخت خودکار آدرس وب‌هوک در CLI
BALEPAY_PUBLIC_ORIGIN=
# اختیاری | پیش‌فرض https://tapi.bale.ai (تنها برای عیب‌یابی تغییر دهید)
BALEPAY_API_BASE=
# قفل دریافت وجه واقعی: تا true نشود، در production صورتحساب صادر نمی‌شود
BALEPAY_ENABLE_LIVE_PAYMENTS=false

# ─── Supabase (دیتابیس، احراز هویت و سبد/سفارش) ─────────────────────────────
# الزامی | نشانی پروژه
SUPABASE_URL=
# الزامی | کلید public/publishable که مرورگر می‌خواند (عمومی است)
SUPABASE_PUBLISHABLE_KEY=
# اختیاری | نام دیگر کلید عمومی در پروژه‌های قدیمی
SUPABASE_ANON_KEY=
# الزامی | راز | service_role — فقط سمت سرور؛ هرگز در مرورگر یا Git
SUPABASE_SERVICE_ROLE_KEY=

# ─── سایر ───────────────────────────────────────────────────────────────────
# اختیاری | راز | کلید Gemini برای دستیار توضیحات محصول (فقط سمت سرور)
GEMINI_API_KEY=
# اختیاری | پورت سرور محلی؛ روی Vercel لازم نیست
PORT=3000
